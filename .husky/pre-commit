#!/usr/bin/env bash
set -u

# 檢查函式的單一真相層是 scripts/audit-template-hygiene.sh —— 這裡 source 進來，
# 不再自帶副本。
#
# 為什麼：先前兩份各自維護，漂移到 12 個共用函式有 8 個不一致，而且方向一致——
# audit 陸續累積的誤判修正（Supabase demo key、550e8400 demo UUID、
# template/docs/{decisions,rules}/、LOCKED clade 投影、.env.example 的 JWT…）
# 一條都沒同步過來。因為這個 hook 的 core.hooksPath 被 template/.vite-hooks/_
# 蓋掉、實際從沒執行過，沒有人會發現。2026-07-31 接線後一天內就踩了三次誤判，
# 其中 LOCKED 投影那條正是連續擋掉 clade v1.4.388 / v1.4.389 交付的原因。
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT_FOR_SOURCE="$(cd "${HOOK_DIR}/.." && pwd)"
# shellcheck source=../scripts/audit-template-hygiene.sh
source "${REPO_ROOT_FOR_SOURCE}/scripts/audit-template-hygiene.sh"

# audit script 是 set -euo pipefail 且自帶 main；被 source 時它不會跑 main（檔尾
# 有 BASH_SOURCE 判定），但 set 選項會留下來。hook 要自己控流程（逐檔累積 finding
# 後一次判定），所以把 -e / pipefail 收掉，只留 -u。
set +e
set +o pipefail

REQUIRED_CHECKS=(
  private-env-file
  secret-like-content
  real-email-identifier
  real-tenant-identifier
  unmarked-starter-only-doc
  dogfood-business-code
  dogfood-schema-hint
  maintenance-script-misplacement
)

HOOK_CHECKS=(
  private-env-file
  secret-like-content
  real-email-identifier
  real-tenant-identifier
  unmarked-starter-only-doc
  dogfood-business-code
  dogfood-schema-hint
  maintenance-script-misplacement
)

failed=0
tmp_paths=""

cleanup() {
  if [[ -n "${tmp_paths}" && -f "${tmp_paths}" ]]; then
    rm -f "${tmp_paths}"
  fi
}
trap cleanup EXIT

# 覆寫 audit 的 reporter：那邊收集進陣列供 print_report 收尾統一輸出，hook 要即時
# 印到 stderr 並記 failed。check 函式在呼叫時才解析函式名，所以 source 之後覆寫即可。
add_finding() {
  local check_name="$1"
  local problem="$2"
  local evidence="$3"
  local fix="$4"
  local bypass="$5"

  {
    printf '[Starter Hygiene] %s 不通過\n' "${check_name}"
    printf '問題: %s\n' "${problem}"
    printf '證據: %s\n' "${evidence}"
    printf '修正方式: %s\n' "${fix}"
    printf '繞過方式: %s\n\n' "${bypass}"
  } >&2

  failed=1
}

report_failure() {
  add_finding "$@"
}

scanner_error() {
  add_finding \
    "maintenance-script-misplacement" \
    "$1" \
    "$2" \
    "修正 hook / rule 對齊問題後重跑；若是 staged blob 問題，請重新 stage 或手動檢查該檔案。" \
    "只有在 Spectra artifact / PR / commit context 記錄明確 rationale 後，才允許維護者明示 bypass。"
}

verify_check_names() {
  local rule_path=".claude/rules/starter-hygiene.md"
  local check_name

  if [[ ${#HOOK_CHECKS[@]} -ne ${#REQUIRED_CHECKS[@]} ]]; then
    scanner_error "hook check name 數量與 rule 預期不一致，為避免 hygiene drift 採 fail-closed。" "hook check list"
    return 1
  fi

  if [[ ! -f "${rule_path}" ]]; then
    scanner_error "找不到 root starter hygiene rule，無法確認 hook check names 是否對齊。" "${rule_path}"
    return 1
  fi

  for check_name in "${REQUIRED_CHECKS[@]}"; do
    if ! contains_item "${check_name}" "${HOOK_CHECKS[@]}"; then
      scanner_error "hook 缺少 Phase A 定義的 check name，為避免靜默污染採 fail-closed。" "missing check: ${check_name}"
      return 1
    fi

    if ! grep -Fq -- "${check_name}" "${rule_path}"; then
      scanner_error "rule 與 hook check name 對不上，為避免 hygiene drift 採 fail-closed。" "${rule_path} + ${check_name}"
      return 1
    fi
  done

  return 0
}

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  scanner_error "無法定位 git repo root，starter hygiene hook 採 fail-closed。" "git rev-parse --show-toplevel"
  exit 1
}

cd "${repo_root}" || {
  scanner_error "無法切換到 git repo root，starter hygiene hook 採 fail-closed。" "${repo_root}"
  exit 1
}

verify_check_names || exit 1

tmp_paths="$(mktemp "${TMPDIR:-/tmp}/starter-hygiene-staged.XXXXXX")" || {
  scanner_error "無法建立暫存路徑清單，starter hygiene hook 採 fail-closed。" "mktemp staged paths"
  exit 1
}

if ! git diff --cached --name-only -z --diff-filter=ACMR -- template > "${tmp_paths}"; then
  scanner_error "無法讀取 staged template path 清單，starter hygiene hook 採 fail-closed。" "git diff --cached --name-only -- template"
  exit 1
fi

staged_paths=()
while IFS= read -r -d '' path; do
  staged_paths+=("${path}")
done < "${tmp_paths}"

if [[ ${#staged_paths[@]} -eq 0 ]]; then
  exit 0
fi

for path in "${staged_paths[@]}"; do
  blob=""

  # Lockfile 豁免——與 scripts/audit-template-hygiene.sh 的 scan_file 對齊。
  # lockfile 內的 email 是上游套件維護者的中繼資料（實例：裝 @evlog/cli 帶進
  # i@izs.me），不是「把某個真人的信箱帶進 starter」，內容檢查一律不適用。
  # 這條先前只存在於 audit script，hook 沒有，於是任何一次 pnpm add 都可能
  # 擋住 commit（2026-07-31 實犯）。
  case "${path}" in
    template/pnpm-lock.yaml|template/package-lock.json|template/yarn.lock|template/bun.lockb)
      continue
      ;;
  esac

  # `.cursor/` 是 `.claude/` 的生成投影 —— 掃來源就夠了，理由與判準見 audit script 的
  # is_projection_of_scanned_source（來源不存在時照掃，不是無條件放行）。
  if is_projection_of_scanned_source "${path}" "${repo_root}"; then
    continue
  fi

  check_private_env_path "${path}"

  if ! blob="$(git show ":${path}" 2>/dev/null)"; then
    report_failure \
      "maintenance-script-misplacement" \
      "無法讀取 staged blob，starter hygiene hook 採 fail-closed。" \
      "${path} + staged blob read failure" \
      "重新 stage 該檔或手動檢查 staged 內容；必要時重跑 full-tree audit。" \
      "只有在 Spectra artifact / PR / commit context 記錄明確 rationale 後，才允許維護者明示 bypass。"
    continue
  fi

  check_env_example_values "${path}" "${blob}"
  check_secret_like_content "${path}" "${blob}"
  check_email_identifiers "${path}" "${blob}"
  check_tenant_identifiers "${path}" "${blob}"
  check_starter_only_docs "${path}" "${blob}"
  check_dogfood_business_code "${path}" "${blob}"
  check_dogfood_schema_hint "${path}" "${blob}"
  check_maintenance_script_misplacement "${path}" "${blob}"
done

if [[ ${failed} -ne 0 ]]; then
  exit 1
fi

exit 0
