{
  "name": "create-nuxt-starter",
  "version": "0.1.0",
  "description": "Interactive CLI to scaffold a Nuxt + Supabase project with selectable features",
  "bin": {
    "create-nuxt-starter": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack src/cli.ts --format esm --out-dir dist",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.mjs",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "nypm": "^0.6.0",
    "pathe": "^2.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
